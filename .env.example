# Copy this file to .env and fill in your own values. .env is ignored by git.
# With no keys at all, `make film` still works from the committed outputs.

# Google AI Studio key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Cloudflare: account ID from the dashboard sidebar, and an API token made
# from the "Workers AI" template (Workers AI Read + Edit).
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Kaggle: Settings -> API -> generate a token. Username is your Kaggle handle.
KAGGLE_USERNAME=
KAGGLE_API_TOKEN=
