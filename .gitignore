# Secrets: never commit
.env
.env.*
!.env.example
kaggle.json
.kaggle/
access_token

# Private working notes (plan, rubric, the brief)
local/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/

# Local store of every generated file by cache key, and job build folders
.cache/

# Editor and OS
.vscode/
.idea/
.DS_Store

# Rendered films are rebuilt by `make film` from the committed outputs; they are
# uploaded with the submission rather than versioned here (about 30 MB per render).
outputs/final/*.mp4

# Derived audio from experiments E10 and E11: rebuilt by `python -m pipeline.experiments E10 E11`;
# their measurements are kept in each results.json.
outputs/experiments/E10_ducking/*.wav
outputs/experiments/E11_loudness_passes/*.wav
